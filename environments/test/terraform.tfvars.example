    subnet_keys         = ["test_subnet"]
    sku_name            = "Standard"
  }
}

nics = {
  "test_nic" = {
    name                           = "nic-monolith-test-001"
    location                       = "centralindia"
    resource_group_name            = "rg-monolith-test-centralindia-001"
