# ============================================================
# Terraform
# ============================================================

# Terraform working directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
# Environment-specific tfvars files may contain sensitive values
*.tfvars
*.tfvars.json

# Allow example variable files to be committed
!*.tfvars.example

# Terraform plan files
*.tfplan
*.plan
planout

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform state lock information
.terraform.tfstate.lock.info

# Terraform CLI configuration files
.terraformrc
terraform.rc


# ============================================================
# Terraform Provider Plugin Cache
# ============================================================

.terraform.d/plugin-cache/


# ============================================================
# Operating System
# ============================================================

# Windows
Thumbs.db
Desktop.ini


# ============================================================
